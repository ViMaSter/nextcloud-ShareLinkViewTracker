<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>sharelinkviewtracker</id>
	<name>Share Link View Tracker</name>
	<summary>Tracks whenever a share is viewed</summary>
	<description>By default shares only track downloads; now views are tracked too</description>
	<version>1.0.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="vincent@mahn.ke" homepage="https://by.vincent.mahn.ke/">Vincent Mahnke</author>
	<namespace>ShareLinkViewTracker</namespace>
	<category>files</category>
	<category>social</category>
	<bugs>https://by.vincent.mahn.ke/issues</bugs>
	<dependencies>
		<nextcloud min-version="31" max-version="34"/>
	</dependencies>
	<activity>
		<settings>
			<setting>OCA\ShareLinkViewTracker\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\ShareLinkViewTracker\Activity\Provider</provider>
		</providers>
	</activity>
	<navigations>
		<navigation>
			<id>sharelinkviewtracker</id>
			<name>Share Link View Tracker</name>
			<route>sharelinkviewtracker.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
